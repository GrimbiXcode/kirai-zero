# --- API ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kirai
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/kirai_test
PORT=3000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API with credentials.
# Web app in dev plus the origins Capacitor uses on iOS/Android.
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost

# Set to true behind TLS in production so session cookies get the Secure flag.
COOKIE_SECURE=false

# --- Mail ---
# Without SMTP_HOST nothing is sent: the confirmation and password reset mails
# are written to the log instead, link included, which is what development
# wants. Setting SMTP_HOST makes MAIL_FROM and APP_URL mandatory.
#
# SMTP_HOST=mail.example.org
# SMTP_PORT=587                 # 465 together with SMTP_SECURE=true
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=kirai-zero <noreply@example.org>
# SUPPORT_EMAIL=hilfe@example.org

# Where the links in those mails point — the web client, not the API.
APP_URL=http://localhost:5173

# --- Web ---
VITE_API_URL=http://localhost:3000
