# --- API ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kirai
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/kirai_test
PORT=3000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API with credentials.
# Web app in dev plus the origins Capacitor uses on iOS/Android.
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost

# Set to true behind TLS in production so session cookies get the Secure flag.
COOKIE_SECURE=false

# --- Web ---
VITE_API_URL=http://localhost:3000
