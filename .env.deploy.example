# Copy to `.env` next to docker-compose.deploy.yml and fill in.
# The only value the deployment strictly requires.

# Database password. Generate one, do not reuse anything:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Mail. Without these the app still runs, but nobody can confirm their address
# or reset a forgotten password — the messages only reach the container log.
# Setting SMTP_HOST makes MAIL_FROM and APP_URL mandatory; the app refuses to
# start otherwise rather than mail out links that point nowhere.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=kirai-zero <noreply@example.org>

# The public address of this installation. The links in those mails are built
# from it, so it has to be the one people actually use.
APP_URL=https://kirai.example.org

# Named in the mail that reports a completed password reset.
SUPPORT_EMAIL=

# Optional: pin a released version instead of tracking `latest`. Edit the
# image line in docker-compose.deploy.yml, for example
#   image: ghcr.io/grimbixcode/kirai-zero:1.2.0
