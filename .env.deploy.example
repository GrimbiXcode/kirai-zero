# Copy to `.env` next to docker-compose.deploy.yml and fill in.
# The only value the deployment strictly requires.

# Database password. Generate one, do not reuse anything:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Optional: pin a released version instead of tracking `latest`. Edit the
# image line in docker-compose.deploy.yml, for example
#   image: ghcr.io/grimbixcode/kirai-zero:1.2.0
